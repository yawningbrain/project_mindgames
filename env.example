# Emotiv LSL Environment Configuration
# Copy this file to .env and fill in your values

# System Configuration (macOS)
# Your system password for sudo access (used to access HID device)
# WARNING: Only set this on a personal machine you trust!
SUDO_PASSWORD=your_password

# LSL Configuration
SRATE=256
LOG_LEVEL=INFO
STREAM_NAME=Epoc X
STREAM_TYPE=EEG

# Optional: Custom paths
# DATA_DIR=data
# LOG_FILE=logs/emotiv.log

